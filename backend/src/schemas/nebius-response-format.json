{
  "type": "json_schema",
  "json_schema": {
    "name": "preproduction_blueprint",
    "strict": true,
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://workflow-finder-audiovisual.local/schemas/blueprint.schema.json",
      "title": "Preproduction Blueprint",
      "description": "Schema v0.1 para un blueprint de preproducción audiovisual.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "objective",
        "constraints",
        "character_requirements",
        "world_requirements",
        "scenes",
        "dependencies",
        "conflicts",
        "approval_gates",
        "next_steps"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "deliverables"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "target_audience": {
              "type": "string",
              "minLength": 1
            },
            "deliverables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "success_criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "budget": {
              "type": "string",
              "minLength": 1
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "delivery_format": {
              "type": "string",
              "minLength": 1
            },
            "aspect_ratio": {
              "type": "string",
              "minLength": 1
            },
            "creative": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "technical": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "legal_and_safety": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "character_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character_id",
              "name",
              "description"
            ],
            "properties": {
              "character_id": {
                "$ref": "#/$defs/simple_id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "casting_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "wardrobe_and_makeup": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "continuity_notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "world_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locations"
          ],
          "properties": {
            "setting": {
              "type": "string",
              "minLength": 1
            },
            "period": {
              "type": "string",
              "minLength": 1
            },
            "visual_language": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "location_id",
                  "name",
                  "description"
                ],
                "properties": {
                  "location_id": {
                    "$ref": "#/$defs/simple_id"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interior_exterior": {
                    "enum": [
                      "interior",
                      "exterior",
                      "mixed"
                    ]
                  },
                  "production_requirements": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "props_and_set_dressing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scene_id",
              "title",
              "description",
              "location_id",
              "character_ids",
              "shots"
            ],
            "properties": {
              "scene_id": {
                "$ref": "#/$defs/simple_id"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "location_id": {
                "$ref": "#/$defs/simple_id"
              },
              "character_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/simple_id"
                }
              },
              "time_of_day": {
                "type": "string",
                "minLength": 1
              },
              "estimated_duration": {
                "type": "string",
                "minLength": 1
              },
              "production_notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "shot_id",
                    "description",
                    "shot_size",
                    "camera_directions",
                    "character_ids"
                  ],
                  "properties": {
                    "shot_id": {
                      "$ref": "#/$defs/simple_id"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "shot_size": {
                      "type": "string",
                      "minLength": 1
                    },
                    "camera_directions": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "framing",
                        "movement"
                      ],
                      "properties": {
                        "framing": {
                          "type": "string",
                          "minLength": 1
                        },
                        "movement": {
                          "type": "string",
                          "minLength": 1
                        },
                        "angle": {
                          "type": "string",
                          "minLength": 1
                        },
                        "lens": {
                          "type": "string",
                          "minLength": 1
                        },
                        "focus": {
                          "type": "string",
                          "minLength": 1
                        },
                        "support": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "character_ids": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/simple_id"
                      }
                    },
                    "location_id": {
                      "$ref": "#/$defs/simple_id"
                    },
                    "audio_requirements": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "lighting_requirements": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "production_notes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dependency_id",
              "dependent_element",
              "required_element",
              "description"
            ],
            "properties": {
              "dependency_id": {
                "$ref": "#/$defs/simple_id"
              },
              "dependent_element": {
                "$ref": "#/$defs/audiovisual_element_reference"
              },
              "required_element": {
                "$ref": "#/$defs/audiovisual_element_reference"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "unresolved",
                  "ready",
                  "blocked"
                ]
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conflict_id",
              "description",
              "severity",
              "affected_elements",
              "decision_required"
            ],
            "properties": {
              "conflict_id": {
                "$ref": "#/$defs/simple_id"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "affected_elements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/audiovisual_element_reference"
                }
              },
              "decision_required": {
                "type": "boolean"
              },
              "approval_gate_id": {
                "$ref": "#/$defs/simple_id"
              },
              "resolution_notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "approval_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approval_gate_id",
              "description",
              "proposed_decision",
              "status"
            ],
            "properties": {
              "approval_gate_id": {
                "$ref": "#/$defs/simple_id"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "conflict_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/simple_id"
                }
              },
              "proposed_decision": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pending",
                  "approved",
                  "modified"
                ]
              },
              "human_decision": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "approve",
                      "modify"
                    ]
                  },
                  "modified_decision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "notes": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decided_by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decided_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "action",
              "production_area",
              "status"
            ],
            "properties": {
              "step_id": {
                "$ref": "#/$defs/simple_id"
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "production_area": {
                "enum": [
                  "production",
                  "direction",
                  "camera",
                  "lighting",
                  "sound",
                  "art",
                  "casting",
                  "locations",
                  "wardrobe_makeup",
                  "postproduction"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed",
                  "blocked"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "due_date": {
                "type": "string",
                "format": "date"
              },
              "related_elements": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/audiovisual_element_reference"
                }
              },
              "depends_on_step_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/simple_id"
                }
              },
              "approval_gate_id": {
                "$ref": "#/$defs/simple_id"
              }
            }
          }
        }
      },
      "$defs": {
        "simple_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "audiovisual_element_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "element_type",
            "element_id"
          ],
          "properties": {
            "element_type": {
              "enum": [
                "scene",
                "shot",
                "character",
                "location"
              ]
            },
            "element_id": {
              "$ref": "#/$defs/simple_id"
            }
          }
        }
      }
    }
  }
}
